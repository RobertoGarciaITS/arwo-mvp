# Non-secret ARWO runtime configuration example.
# Do not place secret values in this file.

ARWO_ENVIRONMENT=sandbox
ARWO_GCP_PROJECT_ID=replace-with-gcp-project-id
ARWO_REGION=replace-with-region
ARWO_RUNTIME_SERVICE_NAME=arwo-runtime
ARWO_LOG_LEVEL=INFO

ARWO_GOOGLE_FORMS_ENABLED=false
ARWO_GOOGLE_DRIVE_ENABLED=false
ARWO_GMAIL_ENABLED=false
ARWO_PUBLICATION_ENABLED=false

ARWO_DRIVE_ROOT_FOLDER_ID=
ARWO_FORM_TEMPLATE_ID=

# Secret values are intentionally absent.
# Runtime should reference approved secret storage for:
# ARWO_GOOGLE_OAUTH_CLIENT_SECRET
# ARWO_GOOGLE_OAUTH_REFRESH_TOKEN
# ARWO_PUBLICATION_ACCESS_TOKEN
