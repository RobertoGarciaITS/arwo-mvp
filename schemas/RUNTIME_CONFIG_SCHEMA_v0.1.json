{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arwo:runtime-config:v0.1",
  "title": "ARWO Runtime Configuration",
  "type": "object",
  "required": [
    "ARWO_ENVIRONMENT",
    "ARWO_GCP_PROJECT_ID",
    "ARWO_REGION",
    "ARWO_RUNTIME_SERVICE_NAME",
    "ARWO_LOG_LEVEL",
    "ARWO_GOOGLE_FORMS_ENABLED",
    "ARWO_GOOGLE_DRIVE_ENABLED",
    "ARWO_GMAIL_ENABLED",
    "ARWO_PUBLICATION_ENABLED"
  ],
  "properties": {
    "ARWO_ENVIRONMENT": {
      "enum": ["local_dev", "sandbox", "production"]
    },
    "ARWO_GCP_PROJECT_ID": {
      "type": "string",
      "minLength": 3
    },
    "ARWO_REGION": {
      "type": "string",
      "minLength": 2
    },
    "ARWO_RUNTIME_SERVICE_NAME": {
      "type": "string",
      "minLength": 3
    },
    "ARWO_LOG_LEVEL": {
      "enum": ["DEBUG", "INFO", "WARNING", "ERROR"]
    },
    "ARWO_GOOGLE_FORMS_ENABLED": {
      "type": "boolean"
    },
    "ARWO_GOOGLE_DRIVE_ENABLED": {
      "type": "boolean"
    },
    "ARWO_GMAIL_ENABLED": {
      "type": "boolean"
    },
    "ARWO_PUBLICATION_ENABLED": {
      "type": "boolean"
    },
    "ARWO_DRIVE_ROOT_FOLDER_ID": {
      "type": ["string", "null"]
    },
    "ARWO_FORM_TEMPLATE_ID": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
